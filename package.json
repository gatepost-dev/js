{
  "name": "gatepost-js",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "check": "run-s check:source check:build check:policy",
    "check:source": "run-s generate:check format:check lint typecheck test",
    "check:build": "run-s build package:check test:browser",
    "check:policy": "run-s tells context:check check:licences workflows:check",
    "check:licences": "run-s licences:check licence-files:check reuse:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && node --test scripts/*.test.mjs",
    "test:browser": "pnpm -r run test:browser",
    "build": "pnpm -r run build",
    "package:check": "pnpm -r run package:check",
    "tells": "python3 spec/scripts/check-tells",
    "context:check": "cmp CONTEXT.md spec/CONTEXT.md",
    "licences:check": "node scripts/check-licences.mjs",
    "licence-files:check": "pnpm -r run licence-files:check",
    "reuse:check": "uvx --with charset-normalizer==3.5.2 reuse@6.2.0 lint",
    "workflows:check": "uvx zizmor@1.30.1 --offline .github/workflows",
    "generate": "node scripts/generate-spec-data.mjs && node scripts/generate-messages.mjs",
    "generate:check": "run-s generate:check:*",
    "generate:check:data": "node scripts/generate-spec-data.mjs --check",
    "generate:check:messages": "node scripts/generate-messages.mjs --check"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^22.20.4",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^65.0.1",
    "fast-check": "^4.10.2",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}

{
  "name": "@gatepost/core",
  "version": "0.1.0-alpha.0",
  "description": "Unofficial. Not made or endorsed by NIPOST. Parse Nigerian postcodes offline.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gatepost-dev/js/tree/main/packages/core#readme",
  "bugs": "https://github.com/gatepost-dev/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatepost-dev/js.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "nigeria",
    "postcode",
    "address",
    "nipost"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "4 KB"
    }
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "mutation": "stryker run",
    "build": "tsdown",
    "package:check": "run-s package:lint package:smoke",
    "package:lint": "publint && attw --pack --profile esm-only && size-limit && api-extractor run",
    "package:smoke": "node scripts/smoke.mjs",
    "api:update": "api-extractor run --local",
    "licence-files:check": "cmp ../../LICENSE LICENSE && cmp ../../NOTICE NOTICE"
  }
}
